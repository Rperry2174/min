{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Min Tauri",
  "version": "0.1.0",
  "identifier": "org.minbrowser.tauri-migration",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Min Tauri Migration",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../icons/icon256.png"
    ]
  }
}
